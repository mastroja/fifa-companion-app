{
  "name": "fifa-career-companion",
  "version": "1.0.0",
  "description": "Companion app for EA FC Career Mode",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.fifa.companion",
    "productName": "EA FC Companion App",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EA FC Companion App"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "schema.sql",
      "assets/**/*"
    ],
    "asarUnpack": [
      "assets/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "mastroja",
      "repo": "fifa-companion-app"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "sql.js": "^1.14.2"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
